menuconfig GPIO
    bool "GPIO"
    help
      GPIO Drivers

if GPIO

config GPIO_NRF5
    bool "Nordic nRF5"
    default y if SOC_NRF52
    help
      Support for the Nordic nRF5 GPIO controller.

config GPIO_SF32LB
    bool "SiFli SF32LB"
    default y if SOC_SF32LB52
    select HAL_SIFLI_GPIO
    help
      Support for the SiFli SF32LB GPIO controller.

config GPIO_T5AI
    bool "T5AI GPIO"
    default y if SOC_T5AI
    help
      Support for the BK7258 AON GPIO controller used by T5AI.

config GPIO_QEMU
    bool "QEMU GPIO"
    default y if SOC_QEMU
    help
      Support for the QEMU GPIO peripheral.

endif # GPIO
