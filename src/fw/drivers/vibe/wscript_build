sources = []
use = ['fw_includes']

if bld.env.CONFIG_VIBE_AW86225:
    sources.append('vibe_aw86225.c')
    use.append('driver_gpio')
elif bld.env.CONFIG_VIBE_AW8623X:
    sources.append('vibe_aw8623x.c')
    use.append('driver_gpio')
elif bld.env.CONFIG_VIBE_DRV2604:
    sources.append('vibe_drv2604.c')
    use.extend([
        'driver_gpio',
        'pbl_includes',
    ])

# Vibration is exposed through the service/app ABI even when a board has no
# actuator. Keep that boundary explicit instead of inheriting another board's
# hardware selection or leaving the ABI unresolved.
if not sources:
    sources.append('vibe_none.c')

bld.objects(
    name='driver_vibe',
    source=sources,
    use=use,
)

bld.env.DRIVERS.append('driver_vibe')
