excl = []
if not bld.env.CONFIG_PROMPT:
    excl += ['prompt.c', 'prompt_commands.c']
if bld.env.CONFIG_SOC_T5AI:
    # Unhygienix has no validated programming/recovery flow. Do not link console
    # protocols that can erase/write raw flash or mutate arbitrary memory
    # behind the host-side guards.
    excl += [
        'dbgserial.c',
        'dbgserial_input.c',
        'pulse_flash_imaging.c',
        'pulse_bulkio_external_flash.c',
        'pulse_bulkio_memory.c',
    ]
else:
    excl += ['dbgserial_t5ai.c', 'dbgserial_input_t5ai.c']

bld.objects(
    name='console',
    source=bld.path.ant_glob('*.c', excl=excl),
    use=['fw_includes'],
)

