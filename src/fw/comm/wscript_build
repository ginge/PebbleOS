excl = []
if bld.env.CONFIG_SOC_T5AI:
    excl.append('ble/gap_le_connect_params.c')
else:
    excl.append('ble/gap_le_connect_params_t5ai.c')
if not bld.env.CONFIG_BT_ANCS_CLIENT:
    excl.append('ble/kernel_le_client/ancs/*.c')
if not bld.env.CONFIG_BT_AMS_CLIENT:
    excl.append('ble/kernel_le_client/ams/*.c')

bld.objects(
    name='comm',
    source=bld.path.ant_glob('**/*.c', excl=excl),
    use=['fw_includes'],
)

