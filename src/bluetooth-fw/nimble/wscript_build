excludes = []
if bld.env.CONFIG_SOC_T5AI:
    excludes.append('gatt_client_discovery.c')
    excludes.append('responsiveness.c')
else:
    excludes.append('gatt_client_discovery_t5ai.c')
    excludes.append('responsiveness_t5ai.c')

if not bld.env.CONFIG_GH3X2X_TUNING_SERVICE_ENABLED:
    excludes.extend(['gh3x2x_tuning_service.c'])

driver_source = bld.path.ant_glob(['*.c'], excl=excludes)

bld.objects(
    source=driver_source,
    target='bt_driver',
    use=[
      'nimble',
      'freertos',
      'fw_includes',
      'pbl_includes',
    ],
)

