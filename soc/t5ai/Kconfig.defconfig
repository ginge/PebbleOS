# SPDX-License-Identifier: Apache-2.0

if SOC_T5AI

config KERNEL_TICK_HZ
    default 1000

config KERNEL_MAX_THREADS
    default 20

config NUM_IRQ_PRIO_BITS
    default 3

config NUM_IRQS
    default 64

config BT_GATT_DISCOVERY_LEASE_SECONDS
    # Keep the existing T5AI lease for gateways with large GATT databases.
    default 120

choice BT_HCI
    default BT_HCI_T5AI
endchoice

config FLASH_BASE
    default 0x02120000
config FLASH_SIZE
    # Logical capacity of the pinned 3808 KiB physical primary_ap_app
    # partition after the BK7258 34:32 protection transform.
    default 0x00380000
config FLASH_OFFSET
    default 0
config FW_FLASH_SIZE
    # Deliberately smaller Pebble AP slot inside primary_ap_app.
    # This is not an OTA slot or a complete factory partition.
    default 0x00190000
config SRAM_BASE
    default 0x28010000
config SRAM_SIZE
    default 0x00056000

# Gabbro reserves 96,256 bytes for AppState on other boards. T5AI's measured
# AppState is 73,936 bytes with Moddable disabled, so retain 3,888 bytes of
# headroom and return the remaining 18 KiB to the kernel heap.
config APP_RAM_GABBRO_RUNTIME_SIZE
    default 77824

endif
