# SPDX-License-Identifier: Apache-2.0

if SOC_T5AI

choice BT_FW
    default BT_FW_NIMBLE
endchoice

config FLASH_BASE
    default 0x02120000
config FLASH_SIZE
    # Logical capacity of the pinned 3808 KiB physical primary_ap_app
    # partition after the BK7258 34:32 protection transform.
    default 0x00380000
config FLASH_OFFSET
    default 0
config FW_FLASH_SIZE
    # Deliberately smaller experimental Pebble slot inside primary_ap_app.
    # This is not an OTA slot or a complete factory partition.
    default 0x000f0000
config SRAM_BASE
    default 0x28010000
config SRAM_SIZE
    default 0x00056000

endif
