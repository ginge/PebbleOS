# Select a SoC backend without changing shared CMake or source-file properties.
# Fail on upstream source/target drift rather than compiling a second backend.
function(t5ai_select_backend target stock backend)
  if(NOT TARGET ${target})
    message(FATAL_ERROR "T5AI backend target missing: ${target}")
  endif()
  get_target_property(directory ${target} SOURCE_DIR)
  get_target_property(sources ${target} SOURCES)
  set(selected)
  set(matches 0)
  foreach(source IN LISTS sources)
    get_filename_component(absolute "${source}" ABSOLUTE BASE_DIR "${directory}")
    if(absolute STREQUAL "${PBL_BASE}/${stock}")
      math(EXPR matches "${matches} + 1")
    else()
      list(APPEND selected "${source}")
    endif()
  endforeach()
  if(NOT matches EQUAL 1)
    message(FATAL_ERROR "T5AI expected one ${stock} in ${target}, found ${matches}")
  endif()
  get_target_property(local_sources soc__t5ai SOURCES)
  set(matches 0)
  foreach(source IN LISTS local_sources)
    get_filename_component(absolute "${source}" ABSOLUTE BASE_DIR "${PBL_BASE}/soc/t5ai")
    if(absolute STREQUAL "${PBL_BASE}/soc/t5ai/${backend}")
      math(EXPR matches "${matches} + 1")
    endif()
  endforeach()
  if(NOT matches EQUAL 1)
    message(FATAL_ERROR "T5AI expected one local backend ${backend}, found ${matches}")
  endif()
  set_property(TARGET ${target} PROPERTY SOURCES "${selected}")
endfunction()

function(t5ai_select_production_backends)
  t5ai_select_backend(pebble__process_management
    pebble/process_management/process_regions.c process_regions.c)
  if(CONFIG_LOG_BACKEND_FLASH)
    t5ai_select_backend(subsys__logging
      subsys/logging/backends/flash_storage.c log_storage.c)
  endif()
endfunction()
cmake_language(DEFER DIRECTORY ${CMAKE_SOURCE_DIR} CALL t5ai_select_production_backends)
