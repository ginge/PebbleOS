choice
    prompt "SoC"
    help
      SoC family. Real boards pick a vendor SoC; QEMU boards pick
      SOC_QEMU and then choose the emulated core.

config SOC_NRF52
    bool "Nordic nRF52"
    select HAL_NORDIC
    select CPU_CORTEX_M4
    select CPU_HAS_FPU

config SOC_SF32LB52
    bool "SiFli SF32LB52"
    select HAL_SIFLI
    select CPU_STAR_MC1
    select CPU_HAS_FPU
    select RAMFUNC

config SOC_T5AI
    bool "Tuya T5AI / BK7258 application CPU"
    select RAMFUNC
    select CPU_CORTEX_M33
    select ARMV8_M_DSP
    select CPU_HAS_FPU

config T5AI_PFS_HEADER_CACHE
    bool "Cache T5AI PFS headers per page"
    depends on SOC_T5AI
    default y

config SOC_QEMU
    bool "QEMU emulated"

config SOC_POSIX
    bool "POSIX host"
    select ARCH_POSIX
    help
      Run the firmware as a native application on a POSIX host
      (Linux, macOS), with emulated peripherals.

endchoice

config SOC
    string
    default "NRF52" if SOC_NRF52
    default "SF32LB52" if SOC_SF32LB52
    help
      Stringified SoC name, for places that need the name as a token
      (e.g. sftool -c). Empty on QEMU and POSIX boards.

config SDL
    bool
    depends on SOC_POSIX
    help
      SDL, for the host halves of the drivers of a native build that
      need a window or its input. Selected by those drivers.

config QEMU
    bool
    default y if SOC_QEMU
    help
      Derived alias for SOC_QEMU. Gates features that don't make
      sense under emulation.

choice
    prompt "Emulated core"
    depends on SOC_QEMU

config SOC_QEMU_CORTEX_M4
    bool "Cortex-M4"
    select CPU_CORTEX_M4

config SOC_QEMU_CORTEX_M33
    bool "Cortex-M33"
    select CPU_CORTEX_M33

endchoice

config T5AI_CORE_CLOCK_HZ
    int
    default 120000000
    depends on SOC_T5AI
config T5AI_CP_HCI_VALIDATED
    bool "Use validated Tuya CP HCI transport"
    depends on SOC_T5AI
