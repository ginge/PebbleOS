choice
    prompt "SoC"
    help
      SoC family. Real boards pick a vendor SoC; QEMU boards pick
      SOC_QEMU and then choose a Cortex core explicitly.

config SOC_NRF52
    bool "Nordic nRF52"

config SOC_SF32LB52
    bool "SiFli SF32LB52"

config SOC_T5AI
    bool "Tuya T5AI / BK7258 application CPU"

config SOC_QEMU
    bool "QEMU emulated"

endchoice

config T5AI_CORE_CLOCK_HZ
    int "T5AI application CPU clock"
    depends on SOC_T5AI
    default 120000000
    help
      Application-core clock requested from BK7258 CP0 after the serialized
      mailbox transport is initialized. Pebble holds one CPU1 DVFS vote for
      the AP firmware lifetime; changing this value also requires updating and
      validating that vote and the matching peripheral timing.

config T5AI_SYSTICK_CLOCK_HZ
    int "T5AI application CPU SysTick clock"
    depends on SOC_T5AI
    default 60000000
    help
      Effective SysTick clock on the BK7258 application CPU. The core and
      peripheral clock remains 120 MHz, but hardware validation shows that the
      application CPU SysTick counter advances at 60 MHz.

config SOC
    string
    default "NRF52" if SOC_NRF52
    default "SF32LB52" if SOC_SF32LB52
    default "T5AI" if SOC_T5AI
    help
      Stringified SoC name, for places that need the name as a token
      (e.g. sftool -c). Empty on QEMU boards.

config QEMU
    bool
    default y if SOC_QEMU
    help
      Derived alias for SOC_QEMU. Gates features that don't make
      sense under emulation.

choice
    prompt "ARM Cortex core"
    default CORTEX_M4 if SOC_NRF52
    default CORTEX_M33 if SOC_SF32LB52 || SOC_T5AI

config CORTEX_M4
    bool "Cortex-M4"

config CORTEX_M33
    bool "Cortex-M33"

endchoice

config MPU_TYPE_ARMV8M
    bool
    default y if CORTEX_M33

config MPU_TYPE_ARMV7M
    bool
    default y if !MPU_TYPE_ARMV8M
