config BOARD_UNHYGIENIX
    bool
    default y
    help
      Unhygienix (The village fishmonger).
      Waveshare T5-E1 Touch AMOLED 1.75 using the PebbleOS kernel.

config T5AI_TASK_CPU_METRICS
    bool "Report task CPU counters every five seconds"
    depends on BOARD_UNHYGIENIX && !T5AI_BG_TRACE && !T5AI_APP_TRACE && !T5AI_BG_PICK_TRACE
    default n
    help
      Snapshot existing scheduler runtime counters without scheduler hooks or
      PC sampling. Report all tasks, including zero runtime, outside IRQ locks.
      Runtime includes interrupts charged to the interrupted task.

config T5AI_STATE_TRACE
    bool "Record T5AI app and background task state across reset"
    depends on BOARD_UNHYGIENIX
    default n
    help
      Optional diagnostic recorder; disabled in normal builds.
      Sample task scheduling state into a bounded RAM ring once per second.
      Print valid records on the next boot if RAM survives the reset.
      Adds a 1536-byte thread stack and an 848-byte retained ring.
      No stack or register tracing; does not change watchdog timing.

config T5AI_REMINDER_PROFILE
    bool "Measure pin/reminder rewrite phases and flash calls"
    depends on BOARD_UNHYGIENIX && !T5AI_BG_TRACE
    default n
    help
      Temporary timing diagnostics for pindb and reminderdb. No stack/register tracing.
      Reports phase wall/CPU times and synchronous flash call totals after DB unlock.
      Keeps shared source unchanged; disables LTO in intercepted translation units.

config T5AI_REBOOT_TRACE
    bool "Trace T5 CP heartbeat and AP reset lifecycle"
    depends on BOARD_UNHYGIENIX
    default n
    help
      Bounded RAM event ring and low-priority UART drain thread.
      Records heartbeat attempts, sends, acknowledgements and reset entry.
      No stack/register tracing or watchdog policy changes.
      Adds a 1536-byte stack, 776-byte retained ring and 776-byte replay buffer.

config T5AI_INTERRUPT_PROFILE
    bool "Measure T5 tick gaps, kernel interrupt masks and clock changes"
    depends on T5AI_REBOOT_TRACE
    default n
    help
      Temporary bounded counters, printed by the existing reboot trace worker.
      No stack or general-register tracing, logging in interrupt context,
      clock writes, task priority changes or tick compensation.
      Disables LTO on intercepted kernel files to preserve diagnostic hooks.

config T5AI_HEAP_TRACE
    bool "Trace bounded kernel allocation history and OOM callers"
    depends on T5AI_REBOOT_TRACE
    default n
    help
      Keep the last 16 kernel heap operations without allocation or logging.
      Existing reboot worker prints heap totals every ten seconds, and recent
      operations when low. Croak OOM dumps history before the existing handler.
      No stack walks, priority changes or allocator policy changes.

config T5AI_FAULT_TRACE
    bool "Capture minimal T5 HardFault evidence"
    depends on BOARD_UNHYGIENIX
    default n
    help
      Wrap only the fatal HardFault vector, preserving the stock handler.
      Send PC/LR, exception context, SCB fault status and active MPU regions
      through bounded emergency CP logs. Recover one original exception
      frame only at MemManage entry. No heap, task locks or stack dump.
      Adds a private 512-byte fault stack; delivery is best effort.

config T5AI_FLASH_PROFILE
    bool "Measure T5 flash IPC operation durations"
    depends on BOARD_UNHYGIENIX
    default n
    help
      Keep lock-free read/write/erase timing and active-operation samples.
      Disabled builds contain no sampling counters or timestamp reads.

config T5AI_DISPLAY_PROFILE
    bool "Measure T5 display frame durations"
    depends on BOARD_UNHYGIENIX
    select PROFILER
    default n
    help
      Enable the stock render profiler and report all-frame timing windows,
      app/compositor phase totals and DMA failures every sixteen updates.
      Disabled builds contain no frame sampling or diagnostic logs.

config T5AI_HCI_PROFILE
    bool "Measure T5 HCI traffic and task state"
    depends on BOARD_UNHYGIENIX
    default n
    help
      Keep transport counters and print periodic heartbeat and disconnect
      snapshots. Disabled builds omit diagnostic counters and task sampling.

config T5AI_BG_PICK_TRACE
    bool "Count actual KernelBG scheduler selections without a trace worker"
    depends on BOARD_UNHYGIENIX && !T5AI_BG_TRACE && !T5AI_APP_TRACE
    default n
    help
      Count runnable KernelBG selections by competing priority and App identity.
      Report peak observed ready age and selector gaps from the AON RTC every
      five seconds using an existing timer task. No dedicated stack or ring.

config T5AI_WDT_RECOVERY_TRACE
    bool "Log priorities and flash activity at KernelBG watchdog expiry"
    select T5AI_FLASH_PROFILE
    depends on BOARD_UNHYGIENIX && !T5AI_WDT_CAUSE_TRACE && !T5AI_BG_TRACE && !T5AI_REMINDER_PROFILE
    default n
    help
      Snapshot App and KernelBG base/effective priorities, held mutex count,
      state and wait queue only when the watchdog invokes BG recovery.
      No periodic sampling or diagnostic task is added.

config T5AI_WDT_CAUSE_TRACE
    bool "Trace watchdog suspension and public feed callers"
    depends on T5AI_BG_PICK_TRACE
    default n
    help
      Record bounded suspend/resume events and last public feed callers with
      RTC, thread and BG callback context. Use the existing selector report
      timer, without allocating a diagnostic thread or changing watchdog policy.

config T5AI_BG_TRACE
    bool "Trace KernelBG scheduling and blocking"
    depends on BOARD_UNHYGIENIX
    default n
    help
      Record callback running, ready and blocked wall time using the AON RTC.
      Capture wait objects, mutex owner and caller without stack walks.
      Board-local compiler instrumentation and linker wrappers leave common
      source unchanged. A bounded worker drains records outside scheduler locks.

config T5AI_APP_TRACE
    bool "Sample App PCs and event processing during BG starvation"
    depends on BOARD_UNHYGIENIX && !T5AI_INTERRUPT_PROFILE
    select T5AI_BG_TRACE
    default n
    help
      Sample interrupted App thread PCs with jittered 7-13 ms intervals.
      Trace the exact App event queue and report processing spans over 100 ms.
      Bounded tables and the BG diagnostic worker keep logging outside ISRs.
      Samples exclude masked interrupts and handler execution.

config T5AI_ACCEL_DISABLED
    bool "Disable QMI8658 acquisition for diagnostic comparison"
    depends on BOARD_UNHYGIENIX && ACCEL_QMI8658_T5AI
    default n
    help
      Power down the QMI8658 during initialization and skip its worker and
      poll timer. Keep the stock accelerometer service and app APIs intact.
      No periodic I2C reads, shake detection or sample delivery occur.

config T5AI_SDK_COMPAT_CACHE
    bool "Cache immutable process SDK compatibility flags"
    depends on BOARD_UNHYGIENIX
    default y
    help
      Avoid repeated privilege transitions in software drawing by publishing
      App/Worker SDK flags in the existing unprivileged read-only data region.
      Flags are refreshed before process launch and invalidated after cleanup.
      Uses eight bytes, no allocation, locks or task-priority changes.

config T5AI_PIXEL_FAST_PATH
    bool "Use the T5AI software pixel plotting fast path"
    depends on BOARD_UNHYGIENIX && SCREEN_COLOR_DEPTH_BITS = 8
    default n
    help
      Combine clipping and bitmap row addressing for rectangular and circular
      8-bit destinations. Opaque pixels use direct stores and transparent
      pixels skip the destination read. Partial alpha uses stock blending.
      Uncommon formats and clip geometry retain the stock implementation.
      Opt-in pending broader watchface and connected-soak coverage.

config T5AI_QMI8658_PROFILE
    bool "Measure QMI8658 acquisition and delivery"
    depends on BOARD_UNHYGIENIX && ACCEL_QMI8658_T5AI
    default n
    help
      Bounded counters reported every five seconds. Worker CPU uses scheduler
      ticks; transfer wall time includes blocking and preemption. No per-byte
      tracing, priority changes or shared kernel instrumentation.

config T5AI_I2C_RX_FIFO
    bool "Batch T5AI I2C receive interrupts using the controller FIFO"
    depends on BOARD_UNHYGIENIX && I2C_T5AI
    default y
    help
      Experimental bounded 4/8/12-byte receive interrupts with a one-byte
      tail. Retain byte-driven writes, bus frequency and completion semantics.

config T5AI_I2C_PROFILE
    bool "Measure T5AI I2C interrupt entries and handler cycles"
    depends on T5AI_QMI8658_PROFILE
    default n
    help
      Count I2C entries, received bytes and DWT handler cycles. Report using
      the QMI five-second profile window without per-byte logging. Handler
      cycles include nested preemption; do not add to scheduler CPU totals.

config T5AI_I2C_RX_FIFO_LIMIT4
    bool "Limit experimental T5AI I2C receive bursts to four bytes"
    depends on T5AI_I2C_RX_FIFO
    default n
    help
      Compare shorter bounded ISR bursts against the twelve-byte maximum.
      Keep the same bus clock and single-byte tail policy.
