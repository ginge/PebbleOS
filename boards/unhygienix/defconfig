# Unhygienix (The village fishmonger): Waveshare T5-E1 Touch AMOLED 1.75

# Independent T5AI hardware with the Gabbro application platform.
# Keep unsupported peripherals explicitly disabled.
# CONFIG_SOC_SF32LB52 is not set
# CONFIG_PBLBOOT is not set
# CONFIG_BACKLIGHT_AW9364E is not set
# CONFIG_PMIC is not set
# CONFIG_PMIC_NPM1300 is not set
# CONFIG_ALS_W1160 is not set
# CONFIG_ALS_SCREEN_COMPENSATION is not set
# CONFIG_OTP_FLASH is not set
# CONFIG_TOUCH_CST816 is not set
# CONFIG_ACCEL_LIS2DW12 is not set
# CONFIG_MAG is not set
# CONFIG_MAG_MMC5603NJ is not set
# CONFIG_PWM is not set
# CONFIG_DYNAMIC_BACKLIGHT is not set
CONFIG_MODDABLE_XS=y

CONFIG_SOC_T5AI=y
CONFIG_PLATFORM_GABBRO=y
CONFIG_BACKLIGHT_T5AI=y
CONFIG_T5AI_SD_PFS=y
CONFIG_GPIO=y
CONFIG_INPUT_GPIO_KEYS=y
CONFIG_I2C=y
CONFIG_UART=y
CONFIG_WATCHDOG=y
CONFIG_TOUCH=y
CONFIG_ACCEL_QMI8658_T5AI=y
CONFIG_BATTERY_T5AI=y
CONFIG_T5AI_CP_HCI_VALIDATED=y
CONFIG_BT_HCI_T5AI=y
CONFIG_BATTERY_WARNING_FIRST_PERCENT=12
CONFIG_BATTERY_WARNING_SECOND_PERCENT=8
CONFIG_ACCEL_SENSITIVITY=y
CONFIG_APP_SCALING=y
CONFIG_ORIENTATION_MANAGER=y

# Keep watchdog/settings phase tracing and flash timing opt-in.
# CONFIG_T5AI_WDT_RECOVERY_TRACE is not set
# CONFIG_T5AI_FLASH_PROFILE is not set

# Use the bounded general flash cache to retain SRAM for the kernel heap.
# CONFIG_T5AI_PFS_HEADER_CACHE is not set

# The protected-image build validates the linker map before packaging.
CONFIG_LINKER_MAP=y

# Keep the unrestricted debug command interface disabled on this board.
# CONFIG_SHELL is not set

# Keep the native-kernel firmware within the pinned AP slot.
CONFIG_LTO=y

# Preserve the measured AppFetch burst capacity and host-only CP transport.
CONFIG_NIMBLE_MSYS_1_BLOCK_COUNT=35
CONFIG_NIMBLE_BLE_TRANSPORT_ACL_COUNT=10
CONFIG_NIMBLE_BLE_TRANSPORT_ACL_FROM_HS_COUNT=10
CONFIG_NIMBLE_BLE_TRANSPORT_ACL_FROM_LL_COUNT=32
CONFIG_NIMBLE_BLE_TRANSPORT_ISO_COUNT=0
CONFIG_NIMBLE_BLE_TRANSPORT_ISO_FROM_HS_COUNT=0
CONFIG_NIMBLE_BLE_TRANSPORT_ISO_FROM_LL_COUNT=0

# Let app throttling run before an overdue task forces a reset.
CONFIG_TASK_WDT_CHECK_PERIOD_MS=1000
CONFIG_TASK_WDT_GRACE_MS=2000

# Qualified display transport and native copy paths; diagnostics stay off.
CONFIG_T5AI_TOUCH_QUEUE_COALESCE=y
CONFIG_T5AI_COMPOSITOR_FAST_PATH=y
CONFIG_T5AI_DISPLAY_RECOVERY=y

# Match the installed CP-awake AP/peripheral savings and dim display policy.
# Requires the pinned alarm-server CP; keep CP low-voltage sleep disabled.
CONFIG_T5AI_POWER_SAVINGS=y

CONFIG_ALS_BITS=12
