# Unhygienix (The village fishmonger): Waveshare T5-E1 Touch AMOLED 1.75

# Independent T5AI hardware with the Gabbro application platform.
# Keep unsupported peripherals explicitly disabled.
# CONFIG_SOC_SF32LB52 is not set
# CONFIG_HAL_SIFLI is not set
# CONFIG_HAL_SIFLI_SF32LB52 is not set
# CONFIG_PBLBOOT is not set
# CONFIG_BACKLIGHT_AW9364E is not set
# CONFIG_VIBE is not set
# CONFIG_PMIC is not set
# CONFIG_PMIC_NPM1300 is not set
# CONFIG_AMBIENT_LIGHT is not set
# CONFIG_AMBIENT_LIGHT_W1160 is not set
# CONFIG_ALS_SCREEN_COMPENSATION is not set
CONFIG_MIC=y
# CONFIG_TEMPERATURE is not set
# CONFIG_FLASH_GD25Q256E is not set
# CONFIG_OTP is not set
# CONFIG_OTP_FLASH is not set
# CONFIG_BATTERY_PMIC is not set
# CONFIG_TOUCH_CST816 is not set
# CONFIG_ACCEL_LIS2DW12 is not set
# CONFIG_MAG is not set
# CONFIG_MAG_MMC5603NJ is not set
# CONFIG_PWM is not set
# CONFIG_DYNAMIC_BACKLIGHT is not set
CONFIG_MODDABLE_XS=y

CONFIG_SOC_T5AI=y
CONFIG_PLATFORM_GABBRO=y
CONFIG_SCREEN_COLOR_DEPTH_BITS_8=y
CONFIG_DISPLAY=y
CONFIG_BACKLIGHT=y
CONFIG_BACKLIGHT_T5AI=y
CONFIG_EXTI=y
CONFIG_FLASH=y
CONFIG_GPIO=y
CONFIG_I2C=y
CONFIG_UART=y
CONFIG_WATCHDOG=y
CONFIG_TOUCH=y
CONFIG_RTC=y
CONFIG_RNG=y
CONFIG_ACCEL_QMI8658_T5AI=y
CONFIG_BATTERY=y
CONFIG_BATTERY_T5AI=y
CONFIG_T5AI_CP_HCI_VALIDATED=y
CONFIG_BT_FW_NIMBLE=y
CONFIG_BATTERY_WARNING_FIRST_PERCENT=12
CONFIG_BATTERY_WARNING_SECOND_PERCENT=8
CONFIG_ACCEL_SENSITIVITY=y
CONFIG_APP_SCALING=y
CONFIG_ORIENTATION_MANAGER=y

# Use the bounded general flash cache to retain SRAM for the kernel heap.
# CONFIG_T5AI_PFS_HEADER_CACHE is not set
